# ============================================================
#  Cyber Hunter Reawakening - example; CyberHunter.bat copies it to revival_config.env on first run
#  Read by the Launcher, run_offline_python.ps1, run_frida_attach.py,
#  the in-game payload and both VPS scripts. Nothing else picks a server.
#
#  127.0.0.1 = LOCAL mode (all servers start on this PC)
#  any other = REMOTE mode (servers run on that VPS)
#
#  Current live server: SEA Reawakening Server (34.142.241.115).
#  The old NA box (136.64.14.144) is retired - do not mix the two.
# ============================================================
REVIVAL_SERVER_IP=34.142.241.115

# Ports (must match on client and server)
REVIVAL_PATCH_PORT=443
REVIVAL_GATEWAY_PORT=10001
REVIVAL_GAMEAPI_PORT=3000
REVIVAL_CONTROL_PANEL_PORT=8888
REVIVAL_REFEREE_PORT=10777
# HTTPS account relay (game-server/src/sync_relay.js). Players never hold the DB password.
REVIVAL_SYNC_PORT=3443

# Client content: latest = 2024 game content (new outfits, Wardrobe Plan,
# new events) from game/Documents/{data,script}.npk. legacy = the old 2021
# tables. If the game ever boots to a black screen, set legacy.
REVIVAL_CLIENT_CONTENT=latest

# Server identity (shown in the Launcher)
REVIVAL_SERVER_NAME=SEA Reawakening Server
REVIVAL_SERVER_REGION=SEA
REVIVAL_SERVER_NATION=SG

# Player auto-update source (HTTPS only). The launcher downloads ONLY the
# player files listed in <url>/update_manifest.json (built by
# Installer\make_update_manifest.py) - never server code or configs.
# REVIVAL_UPDATE_URL=https://raw.githubusercontent.com/navygames/Cyber-Hunter-Reawakening/reawakening-final/

# Game archive mirror (HTTPS only). Default: public GitHub release assets
# of navygames/Cyber-Hunter-Reawakening, tag game-client-v1.
# REVIVAL_GAME_DOWNLOAD_URL=https://example.com/cyberhunter/game-client-v1
